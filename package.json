{
  "name": "pseudo-os",
  "version": "0.0.1",
  "description": "A fake operating system that runs in your browser",
  "main": "build/server.js",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "esbuild src/ts/client/main.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=build/public/shell.js && cp src/public/* build/public/",
    "build:server": "esbuild src/ts/server.ts --bundle --platform=node --packages=external --format=cjs --outfile=build/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && node build/server.js"
  },
  "author": "Guilherme Cardoso",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
